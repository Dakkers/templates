# Staging environment defaults (committed — do NOT put secrets here).
# Loaded when the mode is "staging": `vite build --mode staging`.
#
# Vite exposes variables prefixed with VITE_ to client code. Secrets belong in
# Worker secrets (`wrangler secret put <NAME>`) instead.

VITE_APP_ENV=staging

# Base URL of the upstream REST API the oRPC client calls (browser-facing).
VITE_API_URL=https://api.staging.example.com
