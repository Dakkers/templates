# Development environment defaults (committed — do NOT put secrets here).
# Loaded by `pnpm dev` (Vite's default mode is "development").
#
# Vite exposes variables prefixed with VITE_ to client code. Secrets belong in
# .dev.vars (Worker-side) instead. See .dev.vars.example.

VITE_APP_ENV=development

# Base URL of the upstream REST API the oRPC client calls, exposed to the
# browser. The server may override it with a private origin via API_URL
# (a Worker secret / .dev.vars) — see src/lib/orpc/client.ts.
VITE_API_URL=http://localhost:8787
