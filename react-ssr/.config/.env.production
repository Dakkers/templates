# Production environment defaults (committed — do NOT put secrets here).
# Loaded when the mode is "production", which is Vite's default for
# `vite build` — so a plain `pnpm build` picks this up with no extra flags.
#
# Vite exposes variables prefixed with VITE_ to client code. Secrets belong in
# Worker secrets (`wrangler secret put <NAME>`) instead.

VITE_APP_ENV=production

# Base URL of the upstream REST API the oRPC client calls (browser-facing).
VITE_API_URL=https://api.example.com
